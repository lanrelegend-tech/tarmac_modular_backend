SECRET_KEY=replace-with-a-generated-private-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
DB_ENGINE=sqlite
DATABASE_URL=



DB_HOST=
DB_PORT=
DB_SSLMODE=require
DB_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0
CLOUDINARY_URL=
# Keep localhost for development. In Render, include each frontend origin,
# comma-separated (for example the apex domain and www domain).
FRONTEND_ORIGIN=http://localhost:3000
# Production browser auth uses Secure, HttpOnly, SameSite=None cookies across origins.
# Keep the defaults locally; set these explicitly on Render if you customize them.
AUTH_COOKIE_SECURE=
AUTH_COOKIE_SAMESITE=
# Set both SameSite values to Lax in production after using api.ourtarmac.online.
CSRF_COOKIE_SAMESITE=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Register the backend endpoint in Paystack Dashboard (not the website domain):
# https://tarmac-modular-backend.onrender.com/api/payments/webhook/
# In Render, set this to https://ourtarmac.online/payment-return.
PAYSTACK_CALLBACK_URL=http://localhost:3000/payment-return
# Add this API key only to the backend environment, never the frontend.
RESEND_API_KEY=
# Use these addresses only after adding/verifying ourtarmac.online in Resend
# and creating mailboxes/aliases for support@ and hello@.
DEFAULT_FROM_EMAIL=Tarmac <noreply@ourtarmac.online>
SUPPORT_EMAIL=support@ourtarmac.online
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v27.0
WHATSAPP_MATCH_TEMPLATE=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_LISTING_TEMPLATE=
WHATSAPP_AD_TEMPLATE=
WHATSAPP_SUPPORT_TEMPLATE=
WHATSAPP_OFFICIAL_TEMPLATE=
WHATSAPP_PROMOTION_TEMPLATE=
WHATSAPP_SECURITY_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Keep localhost for development; use https://ourtarmac.online/... in production.
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
PASSWORD_RESET_URL=http://localhost:3000/reset-password
ACCOUNT_DELETE_URL=http://localhost:3000/delete-account
SECURE_SSL_REDIRECT=
SECURE_HSTS_SECONDS=

TRUST_PROXY_SSL_HEADER=False
# Generate a VAPID key pair for branded browser push notifications.
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_CLAIMS_EMAIL=mailto:support@ourtarmac.online
# Optional Sentry project DSN for backend errors and sampled request traces.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.02
